[Unit]
Description=Optional vLLM Langfuse collector

[Service]
Type=simple
# Example paths: adapt to the collector installation, not the model environment.
WorkingDirectory=/opt/ascend-observe
EnvironmentFile=-/etc/vllm-langfuse.env
# Default log mode needs no SDK or credentials. Change to --output langfuse when ready.
ExecStart=/usr/bin/python3 /opt/ascend-observe/collector.py --port 18765 --output log
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
# Example resource budgets; tune independently of the model service.
CPUQuota=50%
MemoryMax=512M
TasksMax=32

[Install]
WantedBy=multi-user.target
